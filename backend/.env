# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb+srv://yt:DKWphyDpgCxCKLFs@backened.tysmlke.mongodb.net/abhimanyu

# JWT Secrets
JWT_ACCESS_SECRET=your_access_token_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE=7d

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OTP Configuration
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
MAX_OTP_ATTEMPTS=3

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=15*60*1000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Application
DEFAULT_CONSULTATION_TIME_MINUTES=15
SOCKET_PING_INTERVAL=25000
SOCKET_PING_TIMEOUT=60000

# Feature Flags
ENABLE_OTP_VERIFICATION=true
ENABLE_SOCKET_REALTIME=true
ENABLE_EMAIL_NOTIFICATIONS=false